set_property IOSTANDARD LVCMOS33 [get_ports i_clk_artyx7]
set_property PACKAGE_PIN P17 [get_ports i_clk_artyx7]
set_property IOSTANDARD LVCMOS33 [get_ports {o_b_vga[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_b_vga[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_b_vga[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_g_vga[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_g_vga[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_g_vga[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_r_vga[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_r_vga[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_r_vga[0]}]
set_property PACKAGE_PIN M3 [get_ports {o_b_vga[2]}]
set_property PACKAGE_PIN M1 [get_ports {o_b_vga[1]}]
set_property PACKAGE_PIN N1 [get_ports {o_b_vga[0]}]
set_property PACKAGE_PIN R2 [get_ports {o_g_vga[2]}]
set_property PACKAGE_PIN T1 [get_ports {o_g_vga[0]}]
set_property PACKAGE_PIN R1 [get_ports {o_g_vga[1]}]
set_property PACKAGE_PIN N4 [get_ports {o_r_vga[2]}]
set_property PACKAGE_PIN P4 [get_ports {o_r_vga[1]}]
set_property PACKAGE_PIN T3 [get_ports {o_r_vga[0]}]
set_property PACKAGE_PIN P5 [get_ports i_rst_sysn]
set_property IOSTANDARD LVCMOS33 [get_ports i_rst_sysn]
set_property PACKAGE_PIN T5 [get_ports o_hsync]
set_property PACKAGE_PIN N5 [get_ports o_vsync]
set_property IOSTANDARD LVCMOS33 [get_ports o_hsync]
set_property IOSTANDARD LVCMOS33 [get_ports o_vsync]

create_clock -period 55.600 -name CLK_3X -waveform {0.000 27.800} [get_pins clk_gen/inst/o_clk_3x]
create_clock -period 39.700 -name CLK_VGA -waveform {0.000 19.850} [get_pins clk_gen/inst/o_clk_vga]
create_generated_clock -name CLK_DIGDUG -source [get_pins clk_gen/o_clk_3x] -edges {1 3 4} -edge_shift {0.000 0.000 0.000} [get_pins digdug_clk_gen/clk_6M_star_buffer/O]



create_clock -period 10.000 -name CLK_MAIN -waveform {0.000 5.000} [get_nets clk_gen/inst/o_clk_main]

set_false_path -from [get_clocks CLK_DIGDUG] -to [get_clocks CLK_MAIN]
set_false_path -from [get_clocks CLK_MAIN] -to [get_clocks CLK_DIGDUG]
set_false_path -from [get_clocks CLK_VGA] -to [get_clocks CLK_MAIN]
set_false_path -from [get_clocks CLK_MAIN] -to [get_clocks CLK_VGA]
